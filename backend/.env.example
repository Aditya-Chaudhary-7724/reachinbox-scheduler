# ---------- Server ----------
# Port the Express API listens on.
PORT=4000
# Origin of the Next.js dashboard. Used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ---------- Data stores (match docker-compose.yml) ----------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ---------- Auth ----------
# Secret used to sign session JWTs and OAuth state. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---------- Slack (OAuth v2, scope: incoming-webhook) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS: use an ngrok URL that forwards to this API, e.g. https://abc123.ngrok-free.app/api/slack/callback
SLACK_REDIRECT_URI=
# 32-byte key, hex encoded (64 chars), used to AES-256-GCM encrypt stored webhook URLs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLACK_TOKEN_ENC_KEY=

# ---------- Worker / throughput ----------
# Jobs processed in parallel per worker process.
WORKER_CONCURRENCY=5
# Minimum gap between any two sends, enforced globally in Redis across all workers.
MIN_SEND_INTERVAL_MS=2000
# Global cap on emails sent per hour across all senders. Leave empty to disable.
MAX_EMAILS_PER_HOUR=
# Per-sender cap per hour. The effective limit is min(this, campaign.hourlyLimit).
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# A row stuck in SENDING longer than this (worker crashed mid-send) may be reclaimed.
STALE_SENDING_MS=300000

# ---------- Email delivery ----------
# Optional fixed Ethereal credentials. If empty, the seed script creates test accounts automatically.
ETHEREAL_USER=
ETHEREAL_PASS=
# true = use nodemailer's jsonTransport (no network). Only for load testing.
MOCK_SMTP=false

# ---------- Bull Board (/admin/queues, basic auth) ----------
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me
